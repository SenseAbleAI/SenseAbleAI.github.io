# Webapp build (full working demo: frontend + backend).
# Build with:  npm run build -- --mode webapp
# Vite loads this file for `--mode webapp`.

# Use the real backend (not the offline mock demo).
VITE_DEMO_MODE=false

# Base URL of the deployed backend API (Azure Web App). Update after deploying.
VITE_API_URL=https://senseable-api.azurewebsites.net
